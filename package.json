{
  "name": "sistema-vestuario-banda",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "start": "node scripts/configure.mjs && ng serve --host 127.0.0.1 --port 4201",
    "build": "node scripts/configure.mjs && ng build",
    "build:production": "node scripts/configure.mjs --required && ng build",
    "preview": "node scripts/serve-preview.mjs",
    "test": "ng test --watch=false",
    "test:db": "node --test tests/*database.test.mjs",
    "test:e2e": "playwright test",
    "qa": "npm test && npm run test:db && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@angular/service-worker": "22.2.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.55.0",
    "jsdom": "^28.0.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
